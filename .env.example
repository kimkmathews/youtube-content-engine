OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override the model used for each role (OpenRouter model ids)
# ORCHESTRATOR_MODEL=z-ai/glm-5.3-flash
# FALLBACK_MODEL=deepseek/deepseek-v4.1-flash-1017
# WRITER_MODEL=deepseek/deepseek-v4.1-flash-1017     # premium: deepseek/deepseek-v4-pro-0813
# WORKER_MODEL=deepseek/deepseek-v4.1-flash-1017
# GRADER_MODEL=z-ai/glm-5.3-flash
# OPENROUTER_QUANTIZATIONS=fp8,fp16,bf16,unknown      # empty = allow 4-bit hosts too
# LLM_RPM_LIMIT=0            # set ~20 when using ":free" model variants
# LLM_MAX_CONCURRENCY=10

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
